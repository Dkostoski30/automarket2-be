# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Database ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/automarket
DB_USERNAME=automarket
DB_PASSWORD=

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ────────────────────────────────────────────────
# docker compose: kafka:19092   |   from the IDE: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Mail (smtp = MailHog | resend) ───────────────────────
MAIL_PROVIDER=smtp
# RESEND_API_KEY is only read when MAIL_PROVIDER=resend. That transport is
# still a placeholder — it logs the message instead of delivering it.
RESEND_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@automarket.com

# ── Security ─────────────────────────────────────────────
# Must be >= 32 chars and identical in gateway and auth-service.
JWT_SECRET=

# Proves to each service that a request came through the gateway. Must be
# identical in the gateway and all five domain services. Unset falls back to a
# known development value, which is fine locally and unsafe anywhere else.
GATEWAY_SHARED_SECRET=

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ── Storage (local | s3) ─────────────────────────────────
# s3 is the default now: with local storage the upload services keep files on
# their own disk, so a second replica cannot serve what the first one wrote.
# docker-compose runs MinIO to provide the S3 endpoint locally.
STORAGE_PROVIDER=s3
S3_BUCKET=uploads
S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=eu-central-1
# Where browsers fetch the objects — MinIO as published by compose, or your CDN.
CDN_URL=http://localhost:9000/uploads

# Only used when STORAGE_PROVIDER=local.
LOCAL_UPLOAD_DIR=./uploads
LOCAL_BASE_URL=http://localhost:8080/uploads

# ── Stripe ───────────────────────────────────────────────
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
