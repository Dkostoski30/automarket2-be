apiVersion: v1
kind: Secret
metadata:
  name: automarket-secret
  namespace: automarket
type: Opaque
stringData:
  DB_PASSWORD: "REPLACE_ME"
  JWT_SECRET: "REPLACE_ME_with_at_least_32_char_random_string"
  GATEWAY_SHARED_SECRET: "REPLACE_ME_with_a_random_string"
  # Only needed once MAIL_PROVIDER is switched to "resend".
  RESEND_API_KEY: "REPLACE_ME"
  STRIPE_SECRET_KEY: "REPLACE_ME"
  STRIPE_WEBHOOK_SECRET: "REPLACE_ME"
