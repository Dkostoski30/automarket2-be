# Copy to secret.yml and replace every REPLACE_ME. secret.yml is gitignored.
#
# Split into one Secret per concern rather than a single automarket-secret that
# every deployment mounted with `envFrom`. That blanket mount is what made the
# old HS256 signing key reachable from notification-service, and it did the same
# for the Stripe keys and the mail API key. Each deployment now lists only the
# Secrets it actually needs, so a compromised pod yields only its own
# credentials.
#
# The JWT *public* key is deliberately not here — it is in configmap.yml, because
# a public key is not a secret and pretending otherwise obscures which half is.

# Needed by every service.
apiVersion: v1
kind: Secret
metadata:
  name: automarket-secret
  namespace: automarket
type: Opaque
stringData:
  DB_PASSWORD: "REPLACE_ME"
  # Proves a request arrived through the gateway. Shared by design: the gateway
  # presents it and all five domain services verify it.
  GATEWAY_SHARED_SECRET: "REPLACE_ME_with_a_random_string"

---
# auth-service only. The single holder of the token-signing key.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM below, and public.pem into configmap.yml as JWT_PUBLIC_KEY.
apiVersion: v1
kind: Secret
metadata:
  name: automarket-jwt-secret
  namespace: automarket
type: Opaque
stringData:
  JWT_PRIVATE_KEY: |
    -----BEGIN PRIVATE KEY-----
    REPLACE_ME
    -----END PRIVATE KEY-----

---
# listing-service, blog-service and MinIO itself. Write access to the bucket;
# reads are anonymous through the ingress and need no credential.
apiVersion: v1
kind: Secret
metadata:
  name: automarket-storage-secret
  namespace: automarket
type: Opaque
stringData:
  S3_ACCESS_KEY: "REPLACE_ME"
  S3_SECRET_KEY: "REPLACE_ME_with_at_least_8_chars"

---
# payment-service only.
apiVersion: v1
kind: Secret
metadata:
  name: automarket-stripe-secret
  namespace: automarket
type: Opaque
stringData:
  STRIPE_SECRET_KEY: "REPLACE_ME"
  STRIPE_WEBHOOK_SECRET: "REPLACE_ME"

---
# notification-service only. Needed once MAIL_PROVIDER switches to "resend";
# the default mailhog path uses no credential.
apiVersion: v1
kind: Secret
metadata:
  name: automarket-mail-secret
  namespace: automarket
type: Opaque
stringData:
  RESEND_API_KEY: "REPLACE_ME"
