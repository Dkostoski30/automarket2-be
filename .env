# ──────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/automarket
DB_USERNAME=automarket
DB_PASSWORD=secret

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────
# Mail (MailHog – dev SMTP server)
# ──────────────────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@automarket.com

# ──────────────────────────────────────────
# JWT
# ──────────────────────────────────────────
JWT_SECRET=change-this-secret-in-production-must-be-at-least-32-chars

# ──────────────────────────────────────────
# CORS / Frontend
# ──────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ──────────────────────────────────────────
# File Storage
# ──────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=/app/uploads
LOCAL_BASE_URL=http://localhost:8080/uploads

# S3 (only used when STORAGE_PROVIDER=s3)
S3_BUCKET=automarket-uploads
CDN_URL=https://cdn.automarket.com

# AWS credentials (only used when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ──────────────────────────────────────────
# Stripe
# ──────────────────────────────────────────
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=automarket
RABBITMQ_PASSWORD=secret
